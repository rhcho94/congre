rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if false;
      // 이벤트 생성은 POST /api/events (Admin SDK) 전담.
      // 클라이언트 직접 생성을 허용하면 unlocked:true 자기부여로
      // 결제 게이트가 우회됨 (2026-08-06 보안 감사 H-2).
      allow create: if false;
      allow update: if false;
    }

    match /clips/{clipId} {
      allow read, create, update, delete: if false;
    }

    match /notifications/{any} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
      allow delete: if false;
    }
  }
}
