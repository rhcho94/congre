# .env.local.example — 이 파일은 커밋해도 안전합니다 (실제 값 없음)
# 실제 설정은 .env.local에 채워주세요 (.gitignore에 포함됨)
#
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → 웹 앱 SDK 구성
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:...

# AWS S3 (영상 업로드)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-bucket-name

# Shotstack 영상 렌더링
# Shotstack 대시보드 → API Keys에서 발급
# SHOTSTACK_ENV: 'stage' (워터마크 있음, 개발용) | 'production' (워터마크 없음, 유료)
# 미설정 시: Vercel production 배포이면 production, 나머지는 stage로 자동 결정
SHOTSTACK_API_KEY=your-shotstack-api-key
SHOTSTACK_ENV=stage

NEXT_PUBLIC_KAKAO_APP_KEY=your-kakao-app-key
# 배포 도메인 (카카오 공유 URL 구성에 사용. 카카오 개발자 콘솔 등록 도메인과 일치해야 함)
NEXT_PUBLIC_APP_URL=https://app.congre.kr

# Resend 이메일 (https://resend.com → API Keys)
# 미설정 시 dry-run 모드 (콘솔 로그만, 실제 발송 없음)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Congre

# SOLAPI SMS (https://solapi.com → API 설정)
# 미설정 시 dry-run 모드 (콘솔 로그만, 실제 발송 없음)
SOLAPI_API_KEY=NCS...
SOLAPI_API_SECRET=...
SOLAPI_SENDER=01012345678

# 운영자 알림 번호 (선택). 설정하면 렌더 지연·환불 확정·렌더 실패 때 운영자에게 문자가 간다
CONGRE_INTERNAL_PHONE=01012345678

# Firebase Admin SDK (서버 전용. Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel cron 인증 (vercel.json의 세 cron이 Authorization: Bearer 로 보낸다)
CRON_SECRET=...

# 토스페이먼츠 결제위젯 (https://developers.tosspayments.com → API 키)
# 로컬·테스트는 test_gck_ / test_gsk_ 쌍, 운영은 live_gck_ / live_gsk_ 쌍.
# 라이브 전환 후 Vercel Preview 배포도 live 키라 실결제가 된다 — 결제 수정은 로컬 테스트 키로 검증
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_...
TOSS_SECRET_KEY=test_gsk_...
