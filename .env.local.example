# .env.local.example — 이 파일은 커밋해도 안전합니다 (실제 값 없음)
# 실제 설정은 .env.local에 채워주세요 (.gitignore에 포함됨)
#
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → 웹 앱 SDK 구성
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:...

# AWS S3 (영상 업로드)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-bucket-name

# Shotstack 영상 렌더링
# Shotstack 대시보드 → API Keys에서 발급
# SHOTSTACK_ENV: 'stage' (워터마크 있음, 개발용) | 'production' (워터마크 없음, 유료)
# 미설정 시: Vercel production 배포이면 production, 나머지는 stage로 자동 결정
SHOTSTACK_API_KEY=your-shotstack-api-key
SHOTSTACK_ENV=stage

NEXT_PUBLIC_KAKAO_APP_KEY=your-kakao-app-key
# 배포 도메인 (카카오 공유 URL 구성에 사용. 카카오 개발자 콘솔 등록 도메인과 일치해야 함)
NEXT_PUBLIC_APP_URL=https://app.congre.kr

# Resend 이메일 (https://resend.com → API Keys)
# 미설정 시 dry-run 모드 (콘솔 로그만, 실제 발송 없음)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Congre

# SOLAPI SMS (https://solapi.com → API 설정)
# 미설정 시 dry-run 모드 (콘솔 로그만, 실제 발송 없음)
SOLAPI_API_KEY=NCS...
SOLAPI_API_SECRET=...
SOLAPI_SENDER=01012345678
